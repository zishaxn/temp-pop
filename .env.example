# ==========================================
# GMAIL INBOX AGENT - CONFIGURATION
# ==========================================

# 1. OpenRouter API Key (Get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Free model — openrouter/free auto-picks an available free model (see https://openrouter.ai/models?q=free)
OPENROUTER_MODEL=openrouter/free

# 2. Telegram Bot Token (Get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 3. Telegram Chat ID (Get by messaging @userinfobot or @raw_data_bot on Telegram)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 4. Path to the Google Cloud OAuth credentials file (Downloaded from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json
